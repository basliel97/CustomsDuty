# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/customs_duty

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-to-a-random-secret-in-production
JWT_REFRESH_SECRET=change-me-to-another-random-secret-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# QR Code
QR_SIGNING_KEY=change-me-to-qr-signing-secret

# Email (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# App
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# Business
SCANNING_FEE_FLAT_ETB=200

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
